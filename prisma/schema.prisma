generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("trabajador")  // "admin" | "trabajador" | "cliente"
  avatarUrl String?
  rubros    String[]  // Rubros asignados (solo para role="cliente")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  articles        Article[]
  solicitudes     SolicitudProcura[]
  adquisiciones   SolicitudAdquisicion[]
  contratos       ContratoCompra[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  type      String     @default("both")
  color     String?
  createdAt DateTime   @default(now())
  articles  Article[]
  suppliers Supplier[]
}

model Tag {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  excerpt     String?
  content     Json?
  coverUrl    String?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  status      String       @default("draft")
  featured    Boolean      @default(false)
  metaTitle   String?
  metaDesc    String?
  views       Int          @default(0)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tags        ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model SupplierPlan {
  id           String     @id @default(uuid())
  name         String
  description  String?
  price        Float?
  currency     String     @default("USD")
  durationDays Int        @default(30)
  isFeatured   Boolean    @default(false)
  badgeLabel   String?
  maxProducts  Int        @default(5)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  suppliers    Supplier[]
}

model Supplier {
  id               String               @id @default(uuid())
  name             String
  slug             String               @unique
  logoUrl          String?
  coverUrl         String?
  description      String?
  country          String
  city             String?
  website          String?
  email            String?
  phone            String?
  whatsapp         String?
  rubro            String?
  categoryId       String?
  category         Category?            @relation(fields: [categoryId], references: [id])
  planId           String?
  plan             SupplierPlan?        @relation(fields: [planId], references: [id])
  planStart        DateTime?
  planEnd          DateTime?
  status           String               @default("pending")
  verified         Boolean              @default(false)
  featured         Boolean              @default(false)
  internalNotes    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  products         SupplierProduct[]
  catalogoProductos ProductoCatalogo[]
  contacts         ContactRequest[]
}

model SupplierProduct {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  moq         String?
  priceRange  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ContactRequest {
  id         String    @id @default(uuid())
  type       String    @default("supplier")
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  name       String
  email      String
  company    String?
  message    String?
  status     String    @default("new")
  createdAt  DateTime  @default(now())
}

model SolicitudProcura {
  id String @id @default(uuid())

  // 1. Reunión
  fecha           String
  empresaCliente  String
  nombreComercial String?
  ciudad          String?
  direccion       String?

  // Cliente vinculado (por cédula/RIF)
  cedulaRif String?
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  // 3. Contexto
  objetivoReunion       String
  resumenCliente        String?
  sectorIndustria       String?
  canalComercializacion String?

  // 6. Observaciones
  fortalezasDetectadas    String[]
  restriccionesDetectadas String[]
  comentariosFinales      String?

  // 7. Próximos pasos
  proximosPasos String[]

  // 8. Elaborado por
  elaboradoPorNombre String
  elaboradoPorCargo  String?
  elaboradoPorFecha  String

  // Relaciones
  contactos   ContactoProcura[]
  productos   ProductoProcura[]
  necesidades NecesidadProcura[]

  // Meta
  status    String   @default("borrador") // borrador | finalizado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Creador
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  adquisicion SolicitudAdquisicion? // relación inversa
}

// ─── Base de datos de clientes ────────────────────────────────────────────────
model Cliente {
  id                    String   @id @default(uuid())
  cedulaRif             String   @unique
  razonSocial           String
  ciudad                String?
  direccion             String?
  sectorIndustria       String?
  canalComercializacion String?

  // Contacto principal registrado en la primera solicitud
  contactoNombre   String?
  contactoCargo    String?
  contactoTelefono String?
  contactoEmail    String?

  // Rubros asignados para acceso de clientes (filtra catálogo y proveedores)
  rubros  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitudes SolicitudProcura[]

  @@index([cedulaRif])
}

model ContactoProcura {
  id          String           @id @default(uuid())
  solicitudId String
  solicitud   SolicitudProcura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  esPrincipal Boolean          @default(false)
  nombre      String
  cargo       String?
  telefono    String?
  email       String?
}

model ProductoProcura {
  id                         String           @id @default(uuid())
  solicitudId                String
  solicitud                  SolicitudProcura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  nombreProducto             String
  categoria                  String?
  descripcionGeneral         String
  caracteristicasPrincipales String[]
  presentaciones             String[]
  materiales                 String[]
  colores                    String[]
  dimensiones                String?
  peso                       String?
  empaque                    String?
  marca                      String?
  referenciaModelo           String?
  paisOrigen                 String?
  usosAplicaciones           String?
  requerimientosEspeciales   String?
  observaciones              String?
  sortOrder                  Int              @default(0)
}

model NecesidadProcura {
  id                      String           @id @default(uuid())
  solicitudId             String
  solicitud               SolicitudProcura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  productoRelacionado     String
  tipoNecesidad           String
  tipoNecesidadOtro       String?
  descripcion             String
  especificacionesMinimas String?
  frecuenciaRequerida     String?
  cantidadReferencial     String?
  prioridad               String?
  observaciones           String?
  sortOrder               Int              @default(0)
}

model SolicitudAdquisicion {
  id String @id @default(uuid())

  // 1. General
  fecha             String
  tipoDocumento     String?
  tipoDocumentoOtro String?
  solicitante       String
  ccNit             String
  telCel            String?
  ext               String?
  email             String

  // 2. Justificación
  descripcionNecesidad String
  pertinencia          String?

  // 3. Objeto
  descripcionObjeto String
  especificaciones  String?
  requierePermisos  String?

  // 4. Obligaciones
  obligaciones String[]

  // 5. Modalidad
  modalidad              String
  justificacionModalidad String

  // 7. Valor
  valorEstimado String

  // 8. Pago
  formaPago   String?
  detallePago String?

  // 9. Criterios
  criterioMenorPrecio Boolean @default(true)
  criterioOtro        String?

  // 10. Contratista
  contratistaNombre   String?
  contratistaCcNit    String?
  contratistaEmail    String?
  contratistaCiudad   String?
  contratistaTelefono String?

  // 13. Plazo
  plazo            String
  cronogramaChina  Json?   // [{etapa, tiempo, observaciones}]

  // 14. Comité
  comiteEvaluador String[]

  // Firmas
  elaboradoPorNombre String?
  elaboradoPorCargo  String?
  elaboradoPorFecha  String?
  contratanteNombre  String?
  contratanteCargo   String?
  contratanteFecha   String?

  // Relaciones
  cotizantes CotizanteAdquisicion[]
  riesgos    RiesgoAdquisicion[]

  // Meta
  status    String   @default("borrador")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Creador
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Vinculación
  solicitudProcuraId String?           @unique
  solicitudProcura   SolicitudProcura? @relation(fields: [solicitudProcuraId], references: [id])
}

model CotizanteAdquisicion {
  id             String               @id @default(uuid())
  solicitudId    String
  solicitud      SolicitudAdquisicion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  productoNombre String?              // ← NUEVO: agrupa cotizaciones por producto
  nombre         String               // proveedor / cotizante
  valor          String
  sortOrder      Int                  @default(0)
}

model RiesgoAdquisicion {
  id          String               @id @default(uuid())
  solicitudId String
  solicitud   SolicitudAdquisicion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  descripcion String
  mitigacion  String?
  asignacion  String               @default("Contratante")
  sortOrder   Int                  @default(0)
}

// ─── Catálogo de Productos de Proveedores ──────────────────────────────────────
model ProductoCatalogo {
  id           String              @id @default(uuid())
  proveedor    String
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  archivoPdf   String?
  nombre       String
  rubro        String?             // Agrupación global (nivel 1)
  categoria    String?             // Nivel 2
  subcategoria String?             // Nivel 3
  descripcion  String?
  material     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  variantes    VarianteCatalogo[]

  @@index([proveedor])
  @@index([supplierId])
  @@index([rubro])
  @@index([categoria])
  @@index([subcategoria])
}

model VarianteCatalogo {
  id         String           @id @default(uuid())
  productoId String
  producto   ProductoCatalogo @relation(fields: [productoId], references: [id], onDelete: Cascade)
  codigo     String?
  medidas    String?
  unidad     String?
  precio     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([productoId])
  @@index([codigo])
}

// ─── Informes de Verificación de Empresas (Due Diligence) ──────────────────
model ReporteVerificacion {
  id                  String   @id @default(uuid())
  nombreEmpresa       String
  nombreEmpresaZh     String?
  estadoEmpresa       String?
  codigoCreditoSocial String?
  puntajeTotal        Int?
  registrosTotales    Int?
  visible             Boolean  @default(true)
  data                Json
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  contratos           ContratoCompra[]

  @@index([createdAt])
}

// ─── Contratos de Compra Internacional (proveedores chinos) ──────────────────
model ContratoCompra {
  id String @id @default(uuid())

  // 1. General
  fecha  String
  numero String?
  status String  @default("borrador") // borrador | finalizado

  // 2. PARTIES — Buyer
  buyerLegalName      String
  buyerTradeName      String?
  buyerAddress        String?
  buyerCountry        String  @default("Venezuela")
  buyerTaxId          String?
  buyerRepresentative String?
  buyerPosition       String?
  buyerEmail          String?

  // 3. PARTIES — Supplier (snapshot + vínculo opcional al Informe de Verificación)
  verificacionId              String?
  verificacion                ReporteVerificacion? @relation(fields: [verificacionId], references: [id], onDelete: SetNull)
  supplierLegalName           String
  supplierTradeName           String?
  supplierAddress             String?
  supplierCountry             String  @default("People's Republic of China")
  supplierUscc                String?
  supplierLegalRepresentative String?
  supplierPosition            String?
  supplierEmail               String?

  // 4. PRODUCTS
  partidas           ContratoPartida[]
  totalContractValue String?

  // 5. PRICE
  currency      String @default("USD")
  incoterm      String @default("FOB") // FOB | CIF | EXW | FCA | DDP | OTHER
  incotermOther String?
  namedPlace    String?

  // 6. PAYMENT TERMS
  pagos              ContratoPago[]
  paymentMethod      String @default("T/T") // T/T | Alibaba Trade Assurance | L/C | OTHER
  paymentMethodOther String?

  // 7. PRODUCTION AND DELIVERY
  productionDays           String?
  productionStart          String? // DATE | RECEIPT OF ADVANCE PAYMENT | APPROVAL OF SPECIFICATIONS
  productionStartDate      String?
  estimatedReadyToShipDate String?

  // 8. WARRANTY
  warrantyMonths         String?
  warrantyStart          String? // DATE OF SHIPMENT | DATE OF ARRIVAL | DATE OF INSTALLATION
  warrantyResponseDays   String?
  warrantyCorrectiveDays String?

  // 9. DELAY AND LIQUIDATED DAMAGES
  delayPercent         String?
  delayPeriod          String? // per week | per day
  delayCapPercent      String?
  delayTerminationDays String?

  // 10. NON-CIRCUMVENTION
  ncDurationYears String?
  ncTerritory     String?

  // 11. LEGAL / LANGUAGE
  governingLaw             String?
  negotiationDays          String  @default("30")
  arbitrationInstitution   String?
  arbitrationSeat          String?
  arbitrationLanguage      String?
  arbitrationLanguageOther String?
  executedIn               String? // EN | CN | EN+CN
  controllingLanguage      String? // EN | CN

  // 12. NOTICES
  buyerNoticeName       String?
  buyerNoticeEmail      String?
  buyerNoticeAddress    String?
  supplierNoticeName    String?
  supplierNoticeEmail   String?
  supplierNoticeAddress String?

  // 13. SIGNATURES
  buyerSigner             String?
  buyerSignerPosition     String?
  buyerSignDate           String?
  supplierSigner          String?
  supplierSignerPosition  String?
  supplierSignDate        String?

  // 14. ANNEXES
  annexA                  Json? // {product, model, brand, specs[5], materials[], dimensions, performance[], certifications[], accessories[]}
  annexB                  Json? // [{poNumber, product, quantity, unitPrice, total, incoterm, loadingPort, destination, productionLeadTime, paymentTerms, warranty}]
  inspectionCompany       String?
  inspectionLocation      String?
  inspectionDate          String?
  inspectionChecklist     String[]
  inspectionStandard      String? // AQL | 100% INSPECTION | TECHNICAL TEST | OTHER
  inspectionStandardOther String?
  annexDDocs              String[]
  annexDOther             String?

  // Meta
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

model ContratoPartida {
  id             String         @id @default(uuid())
  contratoId     String
  contrato       ContratoCompra @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  producto       String         // Product/Model
  especificacion String?
  cantidad       String
  precioUnitario String
  total          String?
  sortOrder      Int            @default(0)
}

model ContratoPago {
  id         String         @id @default(uuid())
  contratoId String
  contrato   ContratoCompra @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  concepto   String         // Advance | Second | Final | ...
  porcentaje String
  monto      String
  sortOrder  Int            @default(0)
}
