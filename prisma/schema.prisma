generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("editor")
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  type      String     @default("both")
  color     String?
  createdAt DateTime   @default(now())
  articles  Article[]
  suppliers Supplier[]
}

model Tag {
  id       String       @id @default(uuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  excerpt     String?
  content     Json?
  coverUrl    String?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  status      String       @default("draft")
  featured    Boolean      @default(false)
  metaTitle   String?
  metaDesc    String?
  views       Int          @default(0)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tags        ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model SupplierPlan {
  id           String     @id @default(uuid())
  name         String
  description  String?
  price        Float?
  currency     String     @default("USD")
  durationDays Int        @default(30)
  isFeatured   Boolean    @default(false)
  badgeLabel   String?
  maxProducts  Int        @default(5)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  suppliers    Supplier[]
}

model Supplier {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  logoUrl       String?
  coverUrl      String?
  description   String?
  country       String
  city          String?
  website       String?
  email         String?
  phone         String?
  whatsapp      String?
  categoryId    String?
  category      Category?         @relation(fields: [categoryId], references: [id])
  planId        String?
  plan          SupplierPlan?     @relation(fields: [planId], references: [id])
  planStart     DateTime?
  planEnd       DateTime?
  status        String            @default("pending")
  verified      Boolean           @default(false)
  featured      Boolean           @default(false)
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      SupplierProduct[]
  contacts      ContactRequest[]
}

model SupplierProduct {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  moq         String?
  priceRange  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ContactRequest {
  id         String    @id @default(uuid())
  type       String    @default("supplier")
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  name       String
  email      String
  company    String?
  message    String?
  status     String    @default("new")
  createdAt  DateTime  @default(now())
}

model SolicitudProcura {
  id String @id @default(uuid())

  // 1. Reunión
  fecha           String
  empresaCliente  String
  nombreComercial String?
  ciudad          String?
  direccion       String?

  // Cliente vinculado (por cédula/RIF)
  cedulaRif String?
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  // 3. Contexto
  objetivoReunion       String
  resumenCliente        String?
  sectorIndustria       String?
  canalComercializacion String?

  // 6. Observaciones
  fortalezasDetectadas    String[]
  restriccionesDetectadas String[]
  comentariosFinales      String?

  // 7. Próximos pasos
  proximosPasos String[]

  // 8. Elaborado por
  elaboradoPorNombre String
  elaboradoPorCargo  String?
  elaboradoPorFecha  String

  // Relaciones
  contactos   ContactoProcura[]
  productos   ProductoProcura[]
  necesidades NecesidadProcura[]

  // Meta
  status    String   @default("borrador") // borrador | finalizado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adquisicion SolicitudAdquisicion? // relación inversa
}

// ─── Base de datos de clientes ────────────────────────────────────────────────
model Cliente {
  id                    String   @id @default(uuid())
  cedulaRif             String   @unique  // Cédula o RIF del cliente
  razonSocial           String
  ciudad                String?
  direccion             String?
  sectorIndustria       String?
  canalComercializacion String?

  // Contacto principal registrado en la primera solicitud
  contactoNombre   String?
  contactoCargo    String?
  contactoTelefono String?
  contactoEmail    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitudes SolicitudProcura[]

  @@index([cedulaRif])
}

model ContactoProcura {
  id          String           @id @default(uuid())
  solicitudId String
  solicitud   SolicitudProcura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  esPrincipal Boolean          @default(false)
  nombre      String
  cargo       String?
  telefono    String?
  email       String?
}

model ProductoProcura {
  id                         String           @id @default(uuid())
  solicitudId                String
  solicitud                  SolicitudProcura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  nombreProducto             String
  categoria                  String?
  descripcionGeneral         String
  caracteristicasPrincipales String[]
  presentaciones             String[]
  materiales                 String[]
  colores                    String[]
  dimensiones                String?
  peso                       String?
  empaque                    String?
  marca                      String?
  referenciaModelo           String?
  paisOrigen                 String?
  usosAplicaciones           String?
  requerimientosEspeciales   String?
  observaciones              String?
  sortOrder                  Int              @default(0)
}

model NecesidadProcura {
  id                      String           @id @default(uuid())
  solicitudId             String
  solicitud               SolicitudProcura @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  productoRelacionado     String
  tipoNecesidad           String
  tipoNecesidadOtro       String?
  descripcion             String
  especificacionesMinimas String?
  frecuenciaRequerida     String?
  cantidadReferencial     String?
  prioridad               String?
  observaciones           String?
  sortOrder               Int              @default(0)
}

model SolicitudAdquisicion {
  id String @id @default(uuid())

  // 1. General
  fecha             String
  tipoDocumento     String?
  tipoDocumentoOtro String?
  solicitante       String
  ccNit             String
  telCel            String?
  ext               String?
  email             String

  // 2. Justificación
  descripcionNecesidad String
  pertinencia          String?

  // 3. Objeto
  descripcionObjeto String
  especificaciones  String?
  requierePermisos  String?

  // 4. Obligaciones
  obligaciones String[]

  // 5. Modalidad
  modalidad              String
  justificacionModalidad String

  // 7. Valor
  valorEstimado String

  // 8. Pago
  formaPago   String?
  detallePago String?

  // 9. Criterios
  criterioMenorPrecio Boolean @default(true)
  criterioOtro        String?

  // 10. Contratista
  contratistaNombre   String?
  contratistaCcNit    String?
  contratistaEmail    String?
  contratistaCiudad   String?
  contratistaTelefono String?

  // 13. Plazo
  plazo            String
  cronogramaChina  Json?   // [{etapa, tiempo, observaciones}]

  // 14. Comité
  comiteEvaluador String[]

  // Firmas
  elaboradoPorNombre String?
  elaboradoPorCargo  String?
  elaboradoPorFecha  String?
  contratanteNombre  String?
  contratanteCargo   String?
  contratanteFecha   String?

  // Relaciones
  cotizantes CotizanteAdquisicion[]
  riesgos    RiesgoAdquisicion[]

  // Meta
  status    String   @default("borrador")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vinculación
  solicitudProcuraId String?           @unique
  solicitudProcura   SolicitudProcura? @relation(fields: [solicitudProcuraId], references: [id])
}

model CotizanteAdquisicion {
  id             String               @id @default(uuid())
  solicitudId    String
  solicitud      SolicitudAdquisicion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  productoNombre String?              // ← NUEVO: agrupa cotizaciones por producto
  nombre         String               // proveedor / cotizante
  valor          String
  sortOrder      Int                  @default(0)
}

model RiesgoAdquisicion {
  id          String               @id @default(uuid())
  solicitudId String
  solicitud   SolicitudAdquisicion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  descripcion String
  mitigacion  String?
  asignacion  String               @default("Contratante")
  sortOrder   Int                  @default(0)
}

// ─── Catálogo de Productos de Proveedores ──────────────────────────────────────
model ProductoCatalogo {
  id           String   @id @default(uuid())
  proveedor    String
  archivoPdf   String?
  nombre       String
  rubro        String?  // Agrupación global (nivel 1)
  categoria    String?  // Nivel 2
  subcategoria String?  // Nivel 3
  descripcion  String?
  codigo       String?
  unidad       String?
  precio       String?
  material     String?
  medidas      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([proveedor])
  @@index([rubro])
  @@index([categoria])
  @@index([subcategoria])
  @@index([codigo])
}
